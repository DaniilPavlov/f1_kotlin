<?xml version="1.0" encoding="utf-8"?>
<!--
  По умолчанию только HTTPS. Тайлы OSM/Carto и API (Jolpica, ESPN) ходят по https.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
